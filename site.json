      "reviews": [
        {
          "name": "Nagy Zoltán",
          "text": "Felhívtak az árral, mielőtt hozzákezdtek. Ez a szerviznél nem szokás – nálunk mégis ez volt.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Szabó Ildikó",
          "text": "Kiderült, hogy a másik szerviz feleslegesen cserélt volna kuplungot. Megmutatták, miért nem kell.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Rácz Péter",
          "text": "Vizsga előtt átnézték, két apróságot javítottak, elsőre átment.",
          "tag": "",
          "image": ""
        }
      ],
      "process": [
        {
          "name": "Hibafelvétel",
          "text": "Behozod, meghallgatunk, kiolvassuk a hibakódot. Ez ingyen van, akkor is, ha nem nálunk javíttatsz.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Árajánlat telefonon",
          "text": "Mielőtt egy csavart is kicsavarnánk, felhívunk a tételes összeggel. Nincs utólagos meglepetés a számlán.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Javítás és átadás",
          "text": "Bontott alkatrészt megmutatjuk, a kocsit mosva adjuk vissza. Számla, garancialevél, kész.",
          "tag": "",
          "image": ""
        }
