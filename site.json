      "faq": [
        {
          "name": "Mennyire steril a műterem?",
          "text": "Minden fém eszköz autoklávban sterilizálva, vendégenként bontott csomagban. A reszelő és a polírozó egyszer használatos – nem fejet cserélünk két vendég között, hanem eszközt.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Milyen anyagokkal dolgoztok?",
          "text": "HEMA-mentes, hipoallergén építőgéllel és géllakkal. Ha eddig bárhol viszketett vagy idő előtt leemelt a köröm, szólj az elején: jó eséllyel az anyag volt a baj, nem a te körmöd.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Meddig tart ki egy építés?",
          "text": "Három-négy hét a töltésig, díszítéssel is. Ha két héten belül letörik egy köröm, díjmentesen pótolom – ez garancia, nem szívesség.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Mennyi időt kérjek rá?",
          "text": "Töltés két óra, új építés két és fél. A foglalás pontosan ennyit zárol, így nem kell sietni, és nem csúszunk rá a következő vendégre.",
          "tag": "",
          "image": ""
        },
        {
          "name": "Le tudom mondani az időpontot?",
          "text": "Igen, 24 órával előtte díjmentesen, a visszaigazoló levélben lévő linkkel. Ezen belül a szolgáltatás felét számoljuk fel: egy két és fél órás helyet aznap már nem tudunk újratölteni.",
          "tag": "",
          "image": ""
        }
      ],
